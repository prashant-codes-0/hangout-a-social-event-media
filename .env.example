JWT_SECRET=

# ---------------------------------------------------------------------------
# Email (Gmail SMTP)
#
# Fill in SMTP_USER and SMTP_PASS and OTPs are delivered to real inboxes.
# Left blank, emails are only printed to the server console and never leave
# this machine.
#
# Gmail does NOT accept your normal account password. Create an App Password:
#   1. Turn on 2-Step Verification for your Google account
#   2. Open https://myaccount.google.com/apppasswords
#   3. Create one (e.g. named "hangouts dev") and paste the 16 chars below
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "Hangouts <SMTP_USER>"
SMTP_FROM=
# Optional dev aid: while testing, every email is redirected to this address
# instead of the real recipient (original recipient is logged)
SMTP_OVERRIDE_TO=

# Frontend URL (used as the link in email bodies)
FRONTEND_URL=



# ---------------------------------------------------------------------------
# Google + Facebook sign-in
#
# Google: create an OAuth 2.0 Client ID of type "Web application" in the
#   Google Cloud Console; put the client id/secret below and add
#   GOOGLE_CALLBACK_URL to its Authorized redirect URIs.
# Facebook: enable "Facebook Login" for your app in the Meta developer
#   dashboard; put the App ID/Secret below and add FACEBOOK_CALLBACK_URL to
#   the Valid OAuth Redirect URIs.
# Left blank, /auth/google and /auth/facebook return a clear 503 telling you
# which variable is missing.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=


FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Web Push (browser notifications when the app is closed). Generated with: npx web-push generate-vapid-keys
# Keep the private key secret. Set the same values in production (Railway).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services if something goes wrong: replace with your own email
VAPID_SUBJECT=

# Cloudinary (chat attachments: images, files, voice notes - max 2 MB each)
# Fill these with the values from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# 2FA authentication else taken from JWT 
TWO_FACTOR_ENCRYPTION_KEY =
TWO_FACTOR_ISSUER=