# Database
MONGODB_URI=mongodb://localhost:27017/hangouts

# JWT
JWT_SECRET=your-super-secret-jwt-key-here

# Email Configuration (Gmail SMTP)
# Set SMTP_USER + SMTP_PASS and OTPs are delivered to the recipient's inbox.
# Leave them blank and emails are only printed to the server console.
#
# Gmail rejects normal passwords: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prashantcodes22@gmail.com
SMTP_PASS=tcju nfwn ujot zprf
# Optional; defaults to "Hangouts <SMTP_USER>"
SMTP_FROM=
# Optional dev aid: while testing, every email is redirected to this address
# instead of the real recipient (original recipient is logged)
SMTP_OVERRIDE_TO="Hangouts App" <noreply@hangouts.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:4200

# Server
PORT=3000

# WebRTC calls (private chat audio/video)
# Without a TURN relay, calls only connect when both people are on "friendly" networks
# (e.g. the same Wi-Fi). Mobile data and strict routers/firewalls need TURN. Set ONE option:
#
# 1) Cloudflare TURN (managed, no server to run): dash.cloudflare.com > Realtime > TURN > create key
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
#
# 2) Your own coturn server with `use-auth-secret` + `static-auth-secret=<TURN_SECRET>`
# 3) A provider's fixed login (Metered, Twilio, ...): set TURN_USERNAME + TURN_CREDENTIAL instead of TURN_SECRET
# TURN_URLS is a comma-separated list, e.g.
#   turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
